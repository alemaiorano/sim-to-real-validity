data/upworthy_raw/
data/mind_raw/
data/reddit_raw/
# Locked corpus JSONs (large, fully regenerable from raw via the ingest scripts; manifests kept)
datasets/*-subset-*.json
datasets/*-confirmatory-*.json
datasets/*-holdout-*.json
!datasets/*.manifest.json
