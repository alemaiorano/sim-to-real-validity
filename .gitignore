latex/*.blg
latex/*.log
latex/*.out
latex/*.synctex.gz
latex/sections/*.aux
# but DO version the compiled paper PDF (camera-ready artifact)
!latex/main.pdf

# Local Python env
.venv/
__pycache__/
*.pyc

